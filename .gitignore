.idea/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Local memory settings (never commit)
config/settings.yaml
config/.env
config/users.yaml
**/users.yaml
# filelock sentinels around users.yaml — runtime, never source.
**/users.yaml.lock
logs/*

# Local-only perf / baseline reports (only fixtures under reports/bench_palace/ are tracked)
reports/memory_perf_*/
reports/memory_quality_*/
reports/architecture_d1_baseline_*/
**/.trash/

# Transient SQLite WAL / SHM next to any chroma.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Finder backup copies ("_副本" = "Copy of …")
*_副本.*
*_copy.*
reports/e2e_*/
