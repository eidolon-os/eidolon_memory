# Default settings template (committed). Copy to memory.default.yaml (gitignore) and edit.
#   cp eidolon/memory/config/memory.default.yaml.example eidolon/memory/config/memory.default.yaml
# Or set EIDOLON_MEMORY_SETTINGS_YAML to point anywhere.
#
# Philosophy: this file holds **only** what differs per machine / per
# deployment. Product constants (wing taxonomy, NATS protocol fields, recall
# heuristics, steward thresholds, KG window/caps, chromadb pragmas, supervisor
# backoff) live in code:
#   - eidolon/memory/domain/wings.py        — CANONICAL_WINGS
#   - eidolon/memory/config/memory_settings.py — pydantic defaults
# Override them via this yaml only if you have a concrete reason; otherwise
# don't paste them in (the defaults are the authoritative source).
#
# Secrets (LLM API key, MCP bearer token) MUST live in env vars — the yaml
# loader rejects inline secrets.

# Where things live on this machine.
runtime:
  palaces_root: ""        # default ~/eidolon/memory/mempalaces; env EIDOLON_MEMORY_PALACES_ROOT
  log_dir: ""             # default ~/eidolon/logs;              env EIDOLON_MEMORY_LOG_DIR
  run_dir: ""             # default ~/eidolon/run;               env EIDOLON_MEMORY_RUN_DIR

# External NATS broker.
nats:
  url: "nats://127.0.0.1:4222"

# LLM provider used by steward. api_key MUST come from env var named below.
llm:
  model: "openai/deepseek-v4-flash"
  base_url: "http://mopai.geni.dyxnet.com.cn/v1"
  api_key_env: "EIDOLON_MEMORY_LLM_API_KEY"

# Per-agent MCP control-plane listener. CLI --port overrides for multi-user.
mcp_http:
  host: "127.0.0.1"
  port: 8030
  bearer_token_env: "EIDOLON_MEMORY_MCP_TOKEN"   # leave empty env = no auth (localhost only)

# Agent-routing discovery HTTP (consumed by external eidolon-agent).
discovery_http:
  host: "127.0.0.1"
  port: 8020

# Steward mode: llm | rule | noop. Default llm; switch to noop for tests.
steward:
  mode: "llm"

# Operator-tunable recall budgets (defaults usually fine).
recall:
  top_k: 5
  livekit_timeout_seconds: 0.3   # LiveKit end-to-end recall budget
